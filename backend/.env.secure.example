# Server Configuration
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3500

# Database
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/career-os?retryWrites=true&w=majority

# JWT Configuration (generate fresh random values)
JWT_SECRET=<generate_64_plus_char_random_secret>
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=<generate_64_plus_char_random_secret>
JWT_REFRESH_EXPIRE=30d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# AI Keys
GEMINI_KEY_1=<gemini_api_key>
GEMINI_KEY_2=<gemini_api_key>
GEMINI_KEY_3=<gemini_api_key>
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=

# Encryption Key for AI Keys in Database (32 chars)
ENCRYPTION_KEY=<32_char_random_key>

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Admin Credentials (set strong random password)
ADMIN_EMAIL=admin@career-os.com
ADMIN_PASSWORD=<strong_unique_password>
