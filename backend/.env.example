# ═══════════════════════════════════════════════════════════
# NIRMAAN PLATFORM — Environment Configuration Template
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────
# Format: mongodb://user:password@host:port/dbname
MONGODB_URI=mongodb://localhost:27017/nirmaan

# ── Redis ────────────────────────────────────────────────────
# Required for async execution queue. Platform degrades gracefully without it.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password

# ── JWT Authentication ────────────────────────────────────────
# Use different secrets for each token type. Must be at least 32 characters.
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Encryption ────────────────────────────────────────────────
# Exactly 32 characters — used for AES-256 encryption of sensitive data.
ENCRYPTION_KEY=your_exactly_32_char_encryption_key

# ── Admin Account ─────────────────────────────────────────────
# Created on first startup. Change immediately after deployment.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_this_immediately

# ── Gemini AI API Keys ────────────────────────────────────────
# Use separate keys per microservice to isolate rate limits.
GEMINI_KEY_1=your_gemini_key_for_dsa
GEMINI_KEY_2=your_gemini_key_for_interview
GEMINI_KEY_3=your_gemini_key_for_resume
GEMINI_KEY_4=your_gemini_key_for_roadmap
GEMINI_KEY_5=your_gemini_key_for_skills
GEMINI_KEY_6=your_gemini_key_general_fallback

# ── Claude AI Fallback (Optional) ────────────────────────────
# Used as fallback when Gemini fails. Leave empty to disable.
ANTHROPIC_API_KEY=your_claude_api_key_here

# ── Judge0 Code Execution (Optional) ─────────────────────────
# Used as fallback when Docker sandbox is unavailable.
JUDGE0_API_KEY=your_judge0_api_key
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com

# ── Docker Execution ──────────────────────────────────────────
# Limits for the Docker sandbox executor
DOCKER_TIME_LIMIT_MS=5000
DOCKER_MEMORY_LIMIT_MB=128
DOCKER_CPU_QUOTA=50000

# ── Email (Optional) ──────────────────────────────────────────
# For password reset and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@yourplatform.com

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
